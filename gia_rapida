\section{Notificaciones Toast}

\begin{itemize}[leftmargin=*]
    \item \textbf{Posición:} Esquina superior derecha
    \item \textbf{Duración:} 4s (info), 6s (error/warning)
    \item \textbf{Max-width:} 400px
    \item \textbf{Padding:} 16px
    \item \textbf{Border-radius:} 8px
    \item \textbf{Z-index:} 9999
\end{itemize}

\textbf{Colores por tipo:}
\begin{itemize}[leftmargin=*]
    \item Éxito: Background \texttt{\#10b981}, texto \texttt{\#FFFFFF}
    \item Error: Background \texttt{\#ef4444}, texto \texttt{\#FFFFFF}
    \item Advertencia: Background \texttt{\#f59e0b}, texto \texttt{\#FFFFFF}
    \item Info: Background \texttt{\#3b82f6}, texto \texttt{\#FFFFFF}
\end{itemize}

\section{Checklist de Implementación}

\begin{enumerate}[leftmargin=*]
    \item ✓ Verificar contraste de colores ≥ 4.5:1
    \item ✓ Aplicar fuente Inter con pesos correctos
    \item ✓ Usar área táctil mínima 44×44px
    \item ✓ Implementar estados hover/focus/active
    \item ✓ Validar responsive en breakpoints clave
    \item ✓ Incluir indicadores de carga
    \item ✓ Añadir atributos ARIA cuando sea necesario
    \item ✓ Probar navegación por teclado
\end{enumerate}

